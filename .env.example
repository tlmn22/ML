# Copy to .env.local for development. Never commit real values.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or legacy service_role key. SERVER ONLY — bypasses RLS.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MLBB data provider ------------------------------------------------------
# rone_arena = real data. mock = demo data for local dev (refused when VERCEL_ENV=production).
MLBB_PROVIDER=mock
RONE_ARENA_BASE_URL=https://arena.rone.dev
RONE_ARENA_ALLOWED_HOSTS=arena.rone.dev,arena.fastapicloud.dev
RONE_ARENA_TIMEOUT_MS=8000

# --- Secrets (generate each with: openssl rand -base64 32) --------------------
# Encrypts stored provider session tokens. Changing it invalidates every linked session.
PROVIDER_TOKEN_ENCRYPTION_KEY=
IP_HASH_SALT=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Rank sync tuning ----------------------------------------------------------
SYNC_INTERVAL_HOURS=12
SYNC_BATCH_SIZE=25
SYNC_REQUEST_DELAY_MS=500
SYNC_TIME_BUDGET_MS=50000
USER_SYNC_COOLDOWN_MINUTES=30
